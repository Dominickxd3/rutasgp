NODE_ENV=production
HOST=0.0.0.0
PORT=3000
SERVE_WEB=true
SWAGGER_ENABLED=false
TRUST_PROXY=false
CORS_ORIGIN=http://10.10.1.6:3000

# Generar una clave para esta instalacion y ejecutar build:production con ella.
# La web actual utiliza una clave compartida incluida en su compilacion.
API_KEY=

# Firma los tokens de sesion de la app movil GPSCamiones. OBLIGATORIA si se usa la app:
# sin ella el login movil se rechaza (HTTP 503). Generar con el mismo comando que API_KEY
# y no reutilizar el valor de API_KEY. Al cambiarla, los celulares deben volver a iniciar sesion.
AUTH_SECRET=
# Vigencia del token (horas). La app lo renueva sola a la mitad; 720 = 30 dias.
AUTH_TOKEN_TTL_HOURS=720
# Un token vencido puede renovarse sin contrasena durante estos dias (celular apagado).
AUTH_REFRESH_GRACE_DAYS=90

GPS_DB_HOST=10.10.1.6
GPS_DB_PORT=1433
GPS_DB_NAME=DB_GP_DistribucionML
GPS_DB_USER=usuario_aplicacion
GPS_DB_PASSWORD=
GPS_DB_ENCRYPT=false
GPS_DB_TRUST_SERVER_CERTIFICATE=true

GPS_COLLECTION_ENABLED=true
GPS_COLLECTION_INTERVAL_SECONDS=30
GPS_EVIDENCE_ENABLED=false
OSRM_ENABLED=true
OSRM_BASE_URL=https://router.project-osrm.org

# Puede definir aqui el resto de variables documentadas en api/.env.example.
