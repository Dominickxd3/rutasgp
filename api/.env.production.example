NODE_ENV=production
HOST=0.0.0.0
PORT=3000
SERVE_WEB=true
SWAGGER_ENABLED=false
TRUST_PROXY=false
CORS_ORIGIN=http://10.10.1.6:3000

# Generar una clave para esta instalacion y ejecutar build:production con ella.
# La web actual utiliza una clave compartida incluida en su compilacion.
API_KEY=

GPS_DB_HOST=10.10.1.6
GPS_DB_PORT=1433
GPS_DB_NAME=DB_GP_DistribucionML
GPS_DB_USER=usuario_aplicacion
GPS_DB_PASSWORD=
GPS_DB_ENCRYPT=false
GPS_DB_TRUST_SERVER_CERTIFICATE=true

GPS_COLLECTION_ENABLED=true
GPS_COLLECTION_INTERVAL_SECONDS=30
GPS_EVIDENCE_ENABLED=false
