# ---------------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------------
# Puerto donde escucha NestJS.
PORT=3000

# Orígenes permitidos por CORS (separados por coma). Solo afecta a navegadores.
# Para un consumidor server-to-server puedes dejar el valor por defecto.
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Seguridad  (OBLIGATORIO en producción)
# ---------------------------------------------------------------------------
# Clave compartida que deben enviar en el header "x-api-key"
# (o "Authorization: Bearer <clave>").
# Vacía = API abierta. Solo válido para desarrollo local.
# Genera una con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=

# Ponlo en "true" cuando la API esté detrás de Nginx / Traefik / un balanceador,
# para que el rate limit use la IP real del cliente.
TRUST_PROXY=false

# Documentación Swagger en /api/docs. Ponlo en "false" para no publicarla.
SWAGGER_ENABLED=true

# Rate limit global por IP: ventana (ms) y peticiones permitidas en esa ventana.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# ---------------------------------------------------------------------------
# Feed GPS del proveedor  (¡solo se usa del lado servidor!)
# ---------------------------------------------------------------------------
FLEET_SOURCE_URL=http://gyztec.sergps.com/plataforma/dao/MysqlRastreo.php?action=listar_unidades_asignadas&id_usuario=464&tipo_usuario=usuario&tipo=Ubicacion

# Opcional: feed de posiciones actuales, usado solo para completar el nombre
# del cliente. Si se omite, se deriva de FLEET_SOURCE_URL cambiando action.
# FLEET_LIVE_SOURCE_URL=http://gyztec.sergps.com/plataforma/dao/MysqlRastreo.php?action=listar_unidades_asignadas_actual&id_usuario=464&tipo_usuario=usuario&tipo=Ubicacion

# ---------------------------------------------------------------------------
# Tiempos (milisegundos)
# ---------------------------------------------------------------------------
UPSTREAM_TIMEOUT_MS=10000
CACHE_TTL_MS=4000
POLL_MIN_INTERVAL_MS=1500
