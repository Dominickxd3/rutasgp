# Opcional: URL pública de la API. Si se omite, usa /api (proxy de Vite/Nginx).
# VITE_API_BASE_URL=https://api.tudominio.com/api

# Estilo vectorial de MapLibre GL JS. OpenFreeMap no requiere API key.
# Para cambiar de proveedor basta con apuntar esta variable a otro estilo.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Vista inicial: Grupo Pecuario S.A.C.
# Av. Canto Bello 177, San Juan de Lurigancho 15408, Lima, Perú.
VITE_MAP_CENTER_LAT=-11.9805473
VITE_MAP_CENTER_LNG=-77.0138466
VITE_MAP_ZOOM=16
VITE_MAP_PITCH=0
VITE_MAP_BEARING=0
VITE_API_BASE_URL=/api
VITE_API_KEY=
